 RowBox[{
  RowBox[{"(*", 
   RowBox[{"\:6d4b\:5730\:7ebf\:7ed8\:56fe\:5c55\:793aeg", "\:ff1a", 
    RowBox[{"\:ff08", "\:5e9e\:52a0\:83b1\:5706\:76d8", "\:ff09"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"drawGeodesic", "[", 
     RowBox[{"q_", ",", "u_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "sol", "}"}], ",", 
      RowBox[{
       RowBox[{"sol", "=", 
        RowBox[{"NDSolve", "[", 
         RowBox[{
          RowBox[{"Join", "[", 
           RowBox[{"cedixian", ",", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"zuobiao", "[", 
                 RowBox[{"[", "k", "]"}], "]"}], "[", "0", "]"}], "==", 
               RowBox[{"q", "[", 
                RowBox[{"[", "k", "]"}], "]"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"k", ",", "dimg"}], "}"}]}], "]"}], ",", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"zuobiao", "[", 
                  RowBox[{"[", "k", "]"}], "]"}], "'"}], "[", "0", "]"}], "==", 
               RowBox[{"u", "[", 
                RowBox[{"[", "k", "]"}], "]"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"k", ",", "dimg"}], "}"}]}], "]"}]}], "]"}], ",", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"zuobiao", "[", 
             RowBox[{"[", "k", "]"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"k", ",", "dimg"}], "}"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"\[Lambda]", ",", "0", ",", "5"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"ParametricPlot", "[", 
        RowBox[{
         RowBox[{"Evaluate", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"zuobiao", "[", 
               RowBox[{"[", "k", "]"}], "]"}], "[", "\[Lambda]", "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"k", ",", "dimg"}], "}"}]}], "]"}], "/.", " ", 
           RowBox[{"sol", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Lambda]", ",", "0", ",", "5"}], "}"}], ",", 
         RowBox[{"PlotRange", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "}"}]}], ",", 
         RowBox[{"Epilog", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Circle", "[", "]"}], ",", 
            RowBox[{"PointSize", "[", "Large", "]"}], ",", "Red", ",", 
            RowBox[{"Point", "[", "q", "]"}], ",", "Blue", ",", 
            RowBox[{"Point", "[", 
             RowBox[{"exp", "[", 
              RowBox[{"q", ",", "u"}], "]"}], "]"}]}], "}"}]}]}], "]"}]}]}], 
     "]"}]}], "\[IndentingNewLine]", 
